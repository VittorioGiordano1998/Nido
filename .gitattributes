# Normalize line endings to LF everywhere.
# The index stores LF; eol=lf keeps the working tree LF even with core.autocrlf=true.
* text=auto eol=lf

# Binary files are not normalized.
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.webp binary
*.ico binary
*.pdf binary
*.zip binary
*.gz binary
*.tgz binary
*.exe binary
*.dll binary
*.pdb binary
