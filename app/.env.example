# Copia questo file in `.env.local` e incolla i valori dal progetto Supabase
# (Dashboard -> Project Settings -> API).
VITE_SUPABASE_URL=https://<project-ref>.supabase.co
VITE_SUPABASE_ANON_KEY=<anon-key>

# Web Push: chiave pubblica VAPID (vedi README, sezione "Push").
# È un valore pubblico; senza di essa la sezione push resta non configurata.
VITE_VAPID_PUBLIC_KEY=

# Solo sviluppo: mostra la "Zona test" (reset dei dati di coppia) nel Profilo.
# Lascialo vuoto in produzione (Vercel).
VITE_ENABLE_TEST_TOOLS=
